<script>
  const DB_NAME =3D 'GameCacheDB';
  const STORE_NAME =3D 'GameFiles';
  const CACHE_DURATION =3D 90 * 24 * 60 * 60 * 1000; // 3 ay
  const FILE_URL =3D 'https://cdn.jsdelivr.net/gh/organ-nizator/ff@main/arc=
h.xml';

  function openDB() {
    return new Promise((resolve, reject) =3D> {
      const request =3D indexedDB.open(DB_NAME, 1);
      request.onupgradeneeded =3D (event) =3D> {
        const db =3D event.target.result;
        db.createObjectStore(STORE_NAME, { keyPath: 'url' });
      };
      request.onsuccess =3D (event) =3D> resolve(event.target.result);
      request.onerror =3D (event) =3D> reject(event.target.error);
    });
  }

  async function saveToCache(url, content) {
    const db =3D await openDB();
    return new Promise((resolve, reject) =3D> {
      const transaction =3D db.transaction(STORE_NAME, 'readwrite');
      const store =3D transaction.objectStore(STORE_NAME);
      const request =3D store.put({ url: url, content: content, timestamp: =
Date.now() });
      request.onsuccess =3D () =3D> resolve();
      request.onerror =3D () =3D> reject(new Error('Cache error'));
    });
  }

  async function getFileFromCache(url) {
    const db =3D await openDB();
    return new Promise((resolve, reject) =3D> {
      const transaction =3D db.transaction(STORE_NAME, 'readonly');
      const store =3D transaction.objectStore(STORE_NAME);
      const request =3D store.get(url);
      request.onsuccess =3D async (event) =3D> {
        const data =3D event.target.result;
        if (data &amp;&amp; (Date.now() - data.timestamp) < CACHE_DURATION)=
 {
          resolve(data.content);
        } else {
          try {
            const response =3D await fetch(url);
            const text =3D await response.text();
            await saveToCache(url, text);
            resolve(text);
          } catch (err) {
            reject(err);
          }
        }
      };
      request.onerror =3D () =3D> reject(new Error('DB error'));
    });
  }

  function PlayTo(button) {
    const iframe =3D document.getElementById(&quot;fr&quot;);
    getFileFromCache(FILE_URL).then((text) =3D> {
      iframe.contentDocument.open();
      iframe.contentDocument.write(text);
      iframe.contentDocument.close();
      iframe.style.display =3D &quot;block&quot;;
      button.style.display =3D &quot;none&quot;;
    }).catch((err) =3D> {
      console.error('Error:', err);
      alert('Oyun y=C3=BCklenemedi.');
    });
  }

  function openFullscreen() {
    getFileFromCache(FILE_URL).then((text) =3D> {
      const newWindow =3D window.open(&quot;&quot;, &quot;_blank&quot;);
      if (newWindow) {
        newWindow.document.open();
        newWindow.document.write(text);
        newWindow.document.close();
      } else {
        alert('Tam ekran a=C3=A7=C4=B1lamad=C4=B1.');
      }
    }).catch((err) =3D> {
      console.error('Error:', err);
      alert('Tam ekran y=C3=BCklenemedi.');
    });
  }
